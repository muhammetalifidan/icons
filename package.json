{
  "name": "@untitledui/vue",
  "version": "0.0.1",
  "description": "Unofficial Vue 3 port of Untitled UI Icons",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:icons && vite build",
    "format": "prettier --write ."
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "keywords": [
    "untitledui",
    "icons",
    "svg",
    "vue",
    "vue-3",
    "vite"
  ],
  "author": "Dilshod Turobov",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "camelcase": "^6.3.0",
    "fs-extra": "^11.1.1",
    "glob": "^10.3.3",
    "prettier": "^3.7.4",
    "svgo": "^3.0.2",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "vue": "^3.5.26"
  }
}
